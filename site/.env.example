# URL до корня OpenAI-совместимого API. Обычно заканчивается на /v1.
LLM_BASE_URL=https://api.openai.com/v1

# Секрет используется только серверным обработчиком и не попадает в браузер.
LLM_API_KEY=replace-me

# Имя модели у выбранного провайдера.
LLM_MODEL=replace-me

# Путь к общей обезличенной статистике. В Docker уже задан через volume.
ANALYTICS_DATA_PATH=./data/global-analytics.json
